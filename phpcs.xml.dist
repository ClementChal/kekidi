<?xml version="1.0"?>
<ruleset name="Kekidi">
    <file>wordpress</file>
    <arg name="extensions" value="php"/>
    <exclude-pattern>*/tests/*</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/verify-theme.php</exclude-pattern>
    <rule ref="WordPress"/>
</ruleset>
