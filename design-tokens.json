{
  "name": "Kekidi?!",
  "version": 1,
  "source": "wordpress/kekidi/style.css",
  "scope": ":root, [data-theme=kekidi]",
  "tokens": {
    "--bg": "oklch(from #FFF8F0 l c h)",
    "--surface": "oklch(100% 0 0)",
    "--fg": "oklch(from #1F1F1F l c h)",
    "--muted": "oklch(42% .014 40)",
    "--border": "var(--fg)",
    "--accent": "oklch(from #FFB5D8 l c h)",
    "--surface-action": "oklch(from #B5E6D3 l c h)",
    "--surface-note": "oklch(from #FFE89A l c h)",
    "--surface-info": "oklch(from #B5DBFF l c h)",
    "--font-display": "'Nunito','Trebuchet MS',sans-serif",
    "--font-body": "'DM Sans',Verdana,sans-serif",
    "--font-mono": "ui-monospace,monospace",
    "--text-small": ".8125rem",
    "--text-body": "1rem",
    "--text-lead": "1.25rem",
    "--text-title": "clamp(2rem,4vw,3rem)",
    "--text-display": "clamp(2.75rem,5.5vw,5rem)",
    "--space-1": ".5rem",
    "--space-2": "1rem",
    "--space-3": "1.5rem",
    "--space-4": "2rem",
    "--space-5": "3rem",
    "--space-6": "5rem",
    "--radius-control": "999px",
    "--radius-card": "1.5rem",
    "--radius-panel": "2rem",
    "--line": "2px solid var(--border)",
    "--shadow": "5px 5px 0 var(--border)",
    "--shadow-large": "8px 8px 0 var(--border)",
    "--ease": "cubic-bezier(.23,1, .32,1)",
    "--color-base-100": "var(--bg)",
    "--color-base-200": "var(--surface)",
    "--color-base-300": "var(--surface-note)",
    "--color-base-content": "var(--fg)",
    "--color-primary": "var(--accent)",
    "--color-primary-content": "var(--fg)",
    "--color-neutral": "var(--fg)",
    "--color-neutral-content": "var(--bg)",
    "--radius-box": "var(--radius-card)",
    "--radius-field": "var(--radius-control)",
    "--depth": "0",
    "--noise": "0"
  }
}
